# Copy to .env (gitignored) and fill in. Used ONLY by the local scripts/ probes.
# In production these live as Supabase Edge Function secrets, never in the front end.

# --- Zendesk (CUI) ---
ZENDESK_SUBDOMAIN=cuiwebteam
ZENDESK_EMAIL=your.work@email.com
# Admin Center > Apps and integrations > APIs > Zendesk API > Add API token
ZENDESK_TOKEN=

# --- Supabase (public by design; real protection is RLS) ---
VITE_SUPABASE_URL=https://vantaufqxthqmlakaxbi.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
